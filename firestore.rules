rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-:]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'tagoresubhash2001@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Appointment validation helper
    function isValidAppointment(data) {
      return data.keys().hasAll([
        'bookingId', 'customerName', 'customerPhone', 'serviceId',
        'serviceName', 'appointmentDate', 'dayOfWeek', 'slotId',
        'startTime', 'endTime', 'slotKey', 'timezone',
        'bookingStatus', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'bookingId', 'customerName', 'customerPhone', 'customerEmail',
        'serviceId', 'serviceName', 'appointmentDate', 'dayOfWeek',
        'slotId', 'startTime', 'endTime', 'slotKey', 'timezone',
        'additionalMessage', 'bookingStatus', 'createdAt'
      ]) &&
      data.bookingId is string && data.bookingId.size() >= 4 && data.bookingId.size() <= 64 &&
      data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100 &&
      data.customerPhone is string && data.customerPhone.size() >= 10 && data.customerPhone.size() <= 20 &&
      (!('customerEmail' in data) || (data.customerEmail is string && data.customerEmail.size() <= 120)) &&
      data.serviceId is string && data.serviceId.size() >= 2 && data.serviceId.size() <= 64 &&
      data.serviceName is string && data.serviceName.size() >= 2 && data.serviceName.size() <= 120 &&
      data.appointmentDate is string && data.appointmentDate.size() == 10 && data.appointmentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
      data.dayOfWeek is string && data.dayOfWeek.size() >= 3 && data.dayOfWeek.size() <= 20 &&
      data.slotId is string && data.slotId.size() <= 20 && data.slotId.matches('^slot-[0-9]{2}$') &&
      data.startTime is string && data.startTime.size() >= 7 && data.startTime.size() <= 20 &&
      data.endTime is string && data.endTime.size() >= 7 && data.endTime.size() <= 20 &&
      data.slotKey is string && data.slotKey.size() >= 15 && data.slotKey.size() <= 30 && data.slotKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}:[0-9]{2}$') &&
      data.timezone is string && data.timezone.size() >= 5 && data.timezone.size() <= 32 &&
      (!('additionalMessage' in data) || (data.additionalMessage is string && data.additionalMessage.size() <= 1000)) &&
      data.bookingStatus in ['pending', 'confirmed', 'cancelled'];
    }

    // SlotReservation validation helper
    function isValidSlotReservation(data) {
      return data.keys().hasAll([
        'slotKey', 'bookingId', 'appointmentDate', 'slotId',
        'status', 'customerPhone', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'slotKey', 'bookingId', 'appointmentDate', 'slotId',
        'status', 'customerPhone', 'createdAt'
      ]) &&
      data.slotKey is string && data.slotKey.size() >= 15 && data.slotKey.size() <= 30 && data.slotKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}:[0-9]{2}$') &&
      data.bookingId is string && data.bookingId.size() >= 4 && data.bookingId.size() <= 64 &&
      data.appointmentDate is string && data.appointmentDate.size() == 10 && data.appointmentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
      data.slotId is string && data.slotId.size() <= 20 && data.slotId.matches('^slot-[0-9]{2}$') &&
      data.status in ['pending', 'confirmed', 'cancelled'] &&
      data.customerPhone is string && data.customerPhone.size() >= 10 && data.customerPhone.size() <= 20;
    }

    // 1. Customer Appointments Collection
    match /appointments/{bookingId} {
      allow get: if isValidId(bookingId);
      allow list: if isAdmin();
      allow create: if isValidId(bookingId) &&
        isValidAppointment(incoming()) &&
        incoming().bookingId == bookingId &&
        incoming().bookingStatus == 'pending';
      allow update: if isValidId(bookingId) && isAdmin();
      allow delete: if isValidId(bookingId) && isAdmin();
    }

    // 2. Real-time Slot Reservations (Concurrency Guard)
    match /slot_reservations/{slotKey} {
      allow get, list: if true;
      allow create: if isValidId(slotKey) &&
        isValidSlotReservation(incoming()) &&
        incoming().slotKey == slotKey &&
        incoming().status == 'pending';
      allow update: if isValidId(slotKey) && isAdmin();
      allow delete: if isValidId(slotKey) && isAdmin();
    }

    // Admin users collection
    match /admins/{userId} {
      allow read, write: if isAdmin();
    }
  }
}
